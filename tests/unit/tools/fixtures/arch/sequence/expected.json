            "items": [
              {
                "kind": "sync",
                "from": "customer",
                "to": "pay-api",
                "text": "Place order",
                "interface": "i-0001"
              },
              {
                "kind": "sync",
                "from": "pay-api",
                "to": "PSP",
                "text": "Authorise card"
              },
              {
                "kind": "reply",
                "from": "PSP",
                "to": "pay-api",
