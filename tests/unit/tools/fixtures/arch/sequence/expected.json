                "from": "pay-api",
                "to": "customer",
                "text": "202 Accepted"
              }
            ]
          },
          {
            "id": "declined",
            "name": "Declined",
            "items": [
              {
                "kind": "sync",
                "from": "customer",
                "to": "pay-api",
                "text": "Place order",
                "interface": "i-0001"
              },
              {
                "kind": "sync",
                "from": "pay-api",
                "to": "PSP",
                "text": "Authorise card"
              },
              {
                "frame": "alt",
                "label": "Soft decline",
                "items": [
                  {
                    "kind": "reply",
                    "from": "PSP",
                    "to": "pay-api",
                    "text": "Soft decline"
                  },
                  {
                    "kind": "sync",
                    "from": "pay-api",
                    "to": "PSP",
                    "text": "Retry authorisation"
                  },
                  {
                    "divider": "cooldown",
