{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onetool.beycom.online/schemas/console/outbox-ack.schema.json",
  "type": "object",
  "required": ["protocol", "protocol_version", "instance_id", "acked_through"],
