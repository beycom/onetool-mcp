# OneTool Admin UI frontend tasks

set shell := ["zsh", "-c"]

default:
    @just --list --unsorted

# Install frontend dependencies from the committed lockfile
install:
    npm ci

# Start the Vite dev server for Admin UI development
dev port="5173":
    npm run dev -- --host 127.0.0.1 --port {{ port }}

# Type check TypeScript without emitting files
typecheck:
    npm run typecheck

# Lint TypeScript, React, config, and script files
lint:
    npm run lint

# Auto-fix lint issues where ESLint can do so safely
lint-fix:
    npm run lint:fix

# Run all frontend unit checks
test: test-unit

# Run Vitest unit/component tests
test-unit:
    npm run test:unit

# Run Playwright browser tests
test-e2e:
    npm run test:e2e

# Check high-severity dependency advisories
deps-check:
    npm run deps-check

# Build and copy the packaged Admin UI assets
build:
    npm run build

# Run the frontend quality gate
check:
    npm run check

# Remove frontend build outputs
clean:
    rm -rf dist src/onetool_admin_ui/dist
