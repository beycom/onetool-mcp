{
  "name": "admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript UI for the shared OneTool Admin App",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test",
    "deps-check": "npm audit --audit-level=high",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/test-ui.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@base-ui/react": "^1.5.0",
    "@legendapp/list": "^3.0.0",
    "@pierre/diffs": "^1.2.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "dompurify": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "~19.2.3",
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.1.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.15",
    "typescript": "~6.0.3"
  }
}
