    "@likec4/icons": "1.46.4",
    "@likec4/layouts": "1.58.0",
    "@mantine/core": "9.2.2",
    "@mantine/hooks": "9.2.2",
    "ag-grid-community": "36.0.1",
    "ag-grid-react": "36.0.1",
    "likec4": "1.58.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
