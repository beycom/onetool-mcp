  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "lodash-es": "4.18.1"
  },
  "scripts": {
    "build": "tsc -b && vite build",
