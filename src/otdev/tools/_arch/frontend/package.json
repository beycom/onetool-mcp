    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:renderer-boundary": "node scripts/verify-renderer-boundary.mjs",
    "verify:offline": "node scripts/verify-offline-build.mjs",
    "generate:icons": "node scripts/generate-icon-inventory.mjs",
    "benchmark:grid": "node scripts/benchmark-grid.mjs",
