# OneArch Diagram Styles

classes: {
  System: {
    width: 200
    height: 80
    style: {
      fill: "#D5DFF2"
      font-color: "#213754"
      border-radius: 8
      stroke: "#2d6cb5"
      stroke-width: 2
    }
  }

  External: {
    width: 200
    height: 80
    style: {
      fill: "#999999"
      font-color: "#FFFFFF"
      border-radius: 8
    }
  }

  App: {
    width: 180
    height: 70
    style: {
      fill: "#C6DBFA"
      font-color: "#1D324C"
      border-radius: 8
      stroke: "#9FBEEC"
      stroke-width: 1
    }
  }

  AppPlaceholder: {
    shape: rectangle
    width: 180
    height: 70
    style: {
      fill: transparent
      stroke: transparent
      font-color: transparent
    }
  }

  Web: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#F6CDC4"
      font-color: "#452D2A"
      border-radius: 6
      stroke: "#D9AAA1"
      stroke-width: 1
    }
  }

  DB: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#DCCEF0"
      font-color: "#392B4B"
      border-radius: 6
      stroke: "#B9A2DC"
      stroke-width: 1
    }
  }

  File: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#CBE9DC"
      font-color: "#264838"
      border-radius: 6
      stroke: "#9FCCB8"
      stroke-width: 1
    }
  }

  API: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#F6DDC0"
      font-color: "#53371E"
      border-radius: 6
      stroke: "#DFC09F"
      stroke-width: 1
    }
  }

  Batch: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#CDE4E8"
      font-color: "#244B53"
      border-radius: 6
      stroke: "#ADCCD3"
      stroke-width: 1
    }
  }

  Queue: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#F1CECE"
      font-color: "#532C2C"
      border-radius: 6
      stroke: "#DAB0B0"
      stroke-width: 1
    }
  }

  Cmp: {
    shape: rectangle
    width: 140
    height: 60
    style: {
      fill: "#DEDFE2"
      font-color: "#2E2E2E"
      border-radius: 6
      stroke: "#C4C5C9"
      stroke-width: 1
    }
  }

  Person: {
    shape: c4-person
    width: 100
    height: 100
    style: {
      fill: "#E8E8E8"
      font-color: "#333333"
    }
  }

  Interface: {
    style: {
      stroke: "#000000"
      font-color: "#404040"
    }
    source-arrowhead.style.font-color: "#404040"
    target-arrowhead.style.font-color: "#404040"
  }

  InterfaceFromFocus: {
    style: {
      stroke: "#84A1EB"
      font-color: "#5A7BC5"
    }
    source-arrowhead.style.font-color: "#5A7BC5"
    target-arrowhead.style.font-color: "#5A7BC5"
  }

  InterfaceToFocus: {
    style: {
      stroke: "#C1A2F3"
      font-color: "#9A7DD0"
    }
    source-arrowhead.style.font-color: "#9A7DD0"
    target-arrowhead.style.font-color: "#9A7DD0"
  }

  ChangeNew: {
    style: {
      stroke: "#2E7D32"
      stroke-width: 3
      fill: "#E0ECE0"
    }
  }

  ChangeChanged: {
    style: {
      stroke: "#F9A825"
      stroke-width: 3
      fill: "#FEF2DE"
    }
  }

  ChangeRemoved: {
    style: {
      stroke: "#C62828"
      stroke-width: 3
      stroke-dash: 3
      fill: "#F6DFDF"
    }
  }

  ChangeImpacted: {
    style: {
      stroke: "#6A1B9A"
      stroke-width: 3
      fill: "#E9DDF0"
    }
  }

  ChangeDependency: {
    style: {
      stroke: "#546E7A"
      stroke-width: 3
      fill: "#E5E9EB"
    }
  }

  IntApi: {
    style: {
      stroke-dash: 0
      stroke-width: 3
    }
  }

  IntEvent: {
    style: {
      stroke-dash: 3
      stroke-width: 2
    }
  }

  IntQueue: {
    style: {
      stroke-dash: 5
      stroke-width: 2
    }
  }

  IntBatch: {
    style: {
      stroke-dash: 8
      stroke-width: 2
    }
  }

  IntFile: {
    style: {
      stroke-dash: 1
      stroke-width: 2
    }
  }

  IntPubsub: {
    style: {
      stroke-dash: 4
      stroke-width: 3
    }
  }
}
