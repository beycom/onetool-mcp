{% extends "base.html" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<h1 class="text-2xl font-bold mb-6">{{ title }}</h1>

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
{% for sys in systems %}
    <a href="{{ sys.id }}.html" class="card bg-base-200 hover:bg-base-300 transition-colors">
        <div class="card-body">
            <h2 class="card-title">{{ sys.name }}</h2>
            {% if sys.description %}
            <p class="text-sm text-base-content/70">{{ sys.description }}</p>
            {% endif %}
            {% if sys.tag %}
            <div class="card-actions justify-end">
                <span class="badge badge-outline">{{ sys.tag }}</span>
            </div>
            {% endif %}
        </div>
    </a>
{% endfor %}
</div>

<footer class="mt-8 pt-4 border-t border-base-300 text-sm text-base-content/50">
    Generated: {{ generated_at }}
</footer>
{% endblock %}
