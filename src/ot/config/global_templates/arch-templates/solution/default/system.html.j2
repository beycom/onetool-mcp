{% extends "base.html" %}
{% from "_diagram_tabs.html.j2" import diagram_tabs %}

{% block content %}
<h1 class="text-3xl font-bold mb-6">{{ system.name }}</h1>

{% if metadata_data %}
<div class="mb-6">
    <div id="metadata-table" class="ag-theme-alpine"></div>
</div>
{% endif %}

{% if related_projects %}
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="projects-content"><span class="collapse-icon mr-1">&#9660;</span>Projects</h2>
    <div id="projects-content">
        <ul class="list-disc list-inside space-y-1">
        {% for proj in related_projects %}
            <li>
                <a href="{{ proj.href }}" class="link link-hover">{{ proj.name }}</a>
                {% if proj.change_types %}
                <span class="text-sm text-base-content/60">({{ proj.change_types | join(', ') }})</span>
                {% endif %}
            </li>
        {% endfor %}
        </ul>
    </div>
</div>
{% endif %}

{% if system.applications %}
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="applications-content"><span class="collapse-icon mr-1">&#9654;</span>Applications</h2>
    <div id="applications-content" style="display: none;" data-collapsed="true">
        <div class="flex justify-end mb-2">
            <button type="button" class="btn btn-xs btn-outline" onclick="downloadTableXLSX('applications-table', 'applications.xlsx')">Export XLSX</button>
        </div>
        <div id="applications-table" class="ag-theme-alpine"></div>
    </div>
</div>
{% endif %}

{% if system.components %}
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="direct-components-content"><span class="collapse-icon mr-1">&#9660;</span>Direct Components</h2>
    <div id="direct-components-content">
        <div class="flex justify-end mb-2">
            <button type="button" class="btn btn-xs btn-outline" onclick="downloadTableXLSX('direct-components-table', 'direct-components.xlsx')">Export XLSX</button>
        </div>
        <div id="direct-components-table" class="ag-theme-alpine"></div>
    </div>
</div>
{% endif %}

{% if interfaces_data %}
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="interfaces-content"><span class="collapse-icon mr-1">&#9654;</span>Interfaces</h2>
    <div id="interfaces-content" style="display: none;" data-collapsed="true">
        <div class="flex justify-end mb-2">
            <button type="button" class="btn btn-xs btn-outline" onclick="downloadTableXLSX('interfaces-table', 'interfaces.xlsx')">Export XLSX</button>
        </div>
        <div id="interfaces-table" class="ag-theme-alpine"></div>
    </div>
</div>
{% endif %}

{% include "_legend.html.j2" %}

{% if diagrams %}
<div class="mb-4">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="diagrams-content"><span class="collapse-icon mr-1">&#9660;</span>Diagrams</h2>
    <div id="diagrams-content">
        {{ diagram_tabs(diagrams, 'diagram-tabs', 'diagram') }}
    </div>
</div>
{% endif %}

{% if additional_diagrams %}
<div class="mb-4">
    <h2 class="text-lg font-semibold mb-2 cursor-pointer select-none" data-collapse="additional-diagrams-content"><span class="collapse-icon mr-1">&#9660;</span>Additional Diagrams</h2>
    <div id="additional-diagrams-content">
        {{ diagram_tabs(additional_diagrams, 'additional-diagram-tabs', 'additional-diagram') }}
    </div>
</div>
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function() {
    {% if metadata_data %}
    initAgGridTable('metadata-table', {{ metadata_data|tojson }}, {{ metadata_columns|tojson }}, {pagination: false});
    {% endif %}

    {% if system.applications %}
    initAgGridTable('applications-table', {{ applications_data|tojson }}, {{ applications_columns|tojson }});
    {% endif %}

    {% if system.components %}
    initAgGridTable('direct-components-table', {{ components_data|tojson }}, {{ components_columns|tojson }});
    {% endif %}

    {% if interfaces_data %}
    initAgGridTable('interfaces-table', {{ interfaces_data|tojson }}, {{ interfaces_columns|tojson }});
    {% endif %}

    initDiagramPanZoom();
    initCollapse();
    initDiagramTabs();
});
</script>

<footer class="mt-8 pt-4 border-t border-base-300 text-sm text-base-content/50">
    Generated: {{ generated_at }}
</footer>
{% endblock %}
