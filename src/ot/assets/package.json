{
  "private": true,
  "type": "module",
  "description": "Build dependencies for inject.js annotation script",
  "dependencies": {
    "optimal-select": "^4.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^27.1.0"
  },
  "scripts": {
    "build": "esbuild inject-src.js --bundle --minify --format=iife --outfile=inject.js --target=es2020",
    "lint": "node --check inject-src.js && node --check inject-src.test.js",
    "test": "node --test inject-src.test.js",
    "check": "npm run lint && npm run test"
  }
}
